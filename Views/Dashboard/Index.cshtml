@* khai báo thư viện / model cần dùng  *@

@model  SIMS.Models.StudentViewModel;




@{
    // phần khai báo 
    @* khai báo ké thừa layout  *@
    Layout = "~/Views/Shared/_layoutSIMS.cshtml";
    ViewData["title"] = "Dashboard";
    ViewData["page"] = "Home";
    ViewData["breadcrumb"] = "Dashboard";
    // cách 1 : truyền biến đưcọ khởi  tạo ở controler  
    // phần name và age vày phải khai báo từ controller và se tự bắn sang view nhé
    var age = ViewData["age"];
    var name = ViewData["name"];

}

<div class="row">
    <div class="col">
        <h1>Dashboard của @name  </h1>
        
        @* cách 2: lấy dữ liệu model đã khởi tạo từ controler *@
        <h2>Student Id: @Model.studentId</h2>
        <h2>Student name: @Model.name</h2>
        <h2>Student address: @Model.address</h2>

    </div>
</div>